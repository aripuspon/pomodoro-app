# Copy these variables into Vercel -> Project Settings -> Environment Variables
# Never commit real secret keys to Git.

# Found in Supabase -> Project Settings -> Data API
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co

# Found in Supabase -> Project Settings -> API Keys (anon / public key)
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional but recommended for server-side profile/webhook administration
# Found in Supabase -> Project Settings -> API Keys (service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret

# Soft Beta Mode keeps all Pro features unlocked until live billing checkout is enabled.
# Set to "false" once subscription payment webhooks are active.
SOFT_BETA_MODE=true

# Optional: Google OAuth Web Client ID for direct Google Identity Services popup sign-in
# (Shows your Vercel/custom domain instead of *.supabase.co during Google login)
GOOGLE_CLIENT_ID=
